{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://focx.ai/contracts/research-report.schema.json",
  "title": "Research report (30-research.json)",
  "description": "Research → Design. Findings with provenance and exactly one recommendation. In nightly mode, carries the top-3 prototype briefs.",
  "type": "object",
  "required": ["runId", "questions", "findings", "recommendation"],
  "additionalProperties": false,
  "properties": {
    "runId": { "type": "string" },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" },
      "description": "The questions this research set out to answer"
    },
    "findings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["finding", "sources"],
        "additionalProperties": false,
        "properties": {
          "finding": { "type": "string" },
          "sources": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        }
      }
    },
    "optionsConsidered": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["option", "assessment"],
        "additionalProperties": false,
        "properties": {
          "option": { "type": "string" },
          "assessment": { "type": "string" }
        }
      }
    },
    "recommendation": { "type": "string", "minLength": 1, "description": "One explicit recommendation. 'It depends' is an invalid artifact." },
    "prototypeBriefs": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["title", "pitch", "feasibility", "designSystemReady"],
        "additionalProperties": false,
        "properties": {
          "title": { "type": "string" },
          "pitch": { "type": "string" },
          "feasibility": { "type": "string", "description": "Why this fits in one run" },
          "designSystemReady": { "type": "boolean", "description": "Buildable drift-free with today's tokens/components?" }
        }
      },
      "description": "Nightly research mode only: the top prototypes worth building, each spawning its own run"
    }
  }
}
