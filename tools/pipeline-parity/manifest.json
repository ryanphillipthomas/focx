{
  "comment": "The pipeline machinery is duplicated across ryanphillipthomas/focx and ryanphillipthomas/studio-810 by hand. This manifest is the record of which files are supposed to stay in lockstep, so that divergence is a failing check instead of a discovery months later. Identical copies of this file must exist in both repos.",
  "repos": [
    "focx",
    "studio-810"
  ],
  "brandTokens": [
    [
      "focx-pipeline",
      "studio-810-pipeline"
    ],
    [
      "focx-staging",
      "wearestudio810-staging"
    ],
    [
      "focx.ai",
      "wearestudio810.com"
    ],
    [
      "design-focx",
      "design-studio810"
    ],
    [
      "Focx",
      "Studio 810"
    ],
    [
      "focx",
      "wearestudio810"
    ],
    [
      "'focx'",
      "'studio810'"
    ],
    [
      "@focx/",
      "@studio810/"
    ]
  ],
  "identical": [
    ".github/workflows/drift-gate.yml",
    ".github/workflows/deploy.yml",
    "tools/contracts/validate.mjs",
    "tools/pipeline-parity/index.mjs",
    "tools/pipeline-parity/manifest.json",
    "docs/pipeline.md",
    "docs/roles/chief.md",
    "docs/roles/product.md",
    "docs/roles/qa.md",
    "docs/roles/deploy.md",
    "tools/deploy-verify/index.mjs"
  ],
  "branded": [
    ".github/workflows/pipeline.yml",
    "pipeline/prompts/qa-agent.md",
    "pipeline/prompts/deploy-agent.md",
    "tools/drift-check/index.mjs",
    "tools/drift-check/package.json"
  ],
  "structure": [
    "pipeline/contracts/run.schema.json",
    "pipeline/contracts/brief.schema.json",
    "pipeline/contracts/product-spec.schema.json",
    "pipeline/contracts/research-report.schema.json",
    "pipeline/contracts/design-spec.schema.json",
    "pipeline/contracts/build-report.schema.json",
    "pipeline/contracts/qa-verdict.schema.json",
    "pipeline/contracts/release-record.schema.json"
  ],
  "local": {
    "comment": "Deliberately repo-specific — each repo describes its own apps, packages, and design-system layering. Listed so the manifest is a complete account of the shared surface rather than a partial one. Not checked. tools/drift-check graduated out of this tier on 2026-08-31 when focx adopted studio-810's generalized parent/child layer model; only the PARENT constant and npm scope differ now, both covered by brand tokens.",
    "paths": [
      ".github/workflows/parity.yml",
      "pipeline/deploy.config.json",
      "AGENTS.md",
      "README.md",
      "render.yaml",
      "pipeline/prompts/build-agent.md",
      "docs/roles/design.md",
      "docs/roles/engineer.md",
      "docs/roles/research.md",
      "docs/sources-of-truth.md",
      "tools/poc-builder/",
      "tools/site-compose/",
      "design/",
      "apps/",
      "packages/"
    ]
  }
}
