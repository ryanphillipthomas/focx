{
  "name": "focx",
  "private": true,
  "version": "0.1.0",
  "description": "focx.ai umbrella organization \u2014 autonomous development monorepo",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "console": "node tools/console-server/index.mjs",
    "test:console": "node --test tools/console-server/test.mjs",
    "drift-check": "node tools/drift-check/index.mjs",
    "test:drift-check": "node --test tools/drift-check/test.mjs",
    "test:contracts": "node --test tools/contracts/test.mjs",
    "focx-bot:check": "node packages/focx-bot/src/index.mjs --validate-contract",
    "focx-bot:plan": "node packages/focx-bot/src/index.mjs apply",
    "focx-bot:verify": "node packages/focx-bot/src/index.mjs verify",
    "test:focx-bot": "node --test packages/focx-bot/test.mjs",
    "test:scripts": "node --test scripts/paperclip-issue-update.test.mjs",
    "console:install": "node tools/console-server/agent.mjs install",
    "console:uninstall": "node tools/console-server/agent.mjs uninstall",
    "console:status": "node tools/console-server/agent.mjs status"
  }
}
